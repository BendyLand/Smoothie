build:
  lash compile
  odin build src -extra-linker-flags:"-L./lib" -debug 
  if [[ -f src.bin ]]; then
    mv src.bin smoothie
  else
    echo "Build failed."
  fi

run:
  odin run src -extra-linker-flags:"-L./lib"

inspect:
  gdb ./smoothie

compile:
  esbuild src/utils.ts > src/utils.js
  esbuild src/app.ts > src/app.js

check:
  odin check src
