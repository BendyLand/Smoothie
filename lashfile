build:
  cp $(find ~/.cache/deno -name "manifold.wasm" | head -n 1) public/manifold.wasm
  deno run -A build.ts

run:
  deno run --allow-net --allow-read serve.ts

check:
  deno check src/app.ts

view:
  if [[ -f ~/Downloads/smoothie_model.glb ]]; then
    f3d ~/Downloads/smoothie_model.glb
  elif [[ -f ~/Downloads/smoothie_model.stl ]]; then
    f3d ~/Downloads/smoothie_model.stl
  else
    echo "Model not downloaded"
  fi

clean-downloads:
  rm ~/Downloads/*
